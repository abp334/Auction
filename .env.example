# Frontend environment variables
VITE_API_URL=/api/v1
VITE_SERVER_URL=http://localhost:5001

# Docker Compose can also read these from a root .env (gitignored) for image uploads:
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=auction-media

# Docker (optional): run the full stack locally
#   docker compose up --build          → http://localhost:8080
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build  → hot reload
